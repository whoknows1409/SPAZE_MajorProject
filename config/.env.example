# SPAZE Configuration
# Copy this to .env and fill in actual values

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
DEBUG=true

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spaze
DB_USER=spaze_admin
DB_PASSWORD=CHANGE_ME

# Redis (Ephemeral Key Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=spaze
MQTT_PASSWORD=CHANGE_ME

# Cryptography
KEY_TTL_SECONDS=60
MASTER_KEY_PATH=./secrets/master.key

# BLE Configuration
BLE_RSSI_THRESHOLD=-65
BLE_SCAN_INTERVAL_MS=500
GRACE_PERIOD_SECONDS=5

# Geofencing
GEOFENCE_ENABLED=true
AUTO_REVOKE_ON_EXIT=true
